{
  "display_information": {
    "name": "CAV_Chef"
  },
  "features": {
    "bot_user": {
      "display_name": "CAV_Chef",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:read",
        "groups:read",
        "users:read",
        "lists:read",
        "files:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
